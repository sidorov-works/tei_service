# dockerfile.base

# Базовый образ с Python 3.11 (легковесная версия slim)
FROM python:3.11-slim

# ============================================
# 1. СИСТЕМНЫЕ ЗАВИСИМОСТИ
# ============================================
# Устанавливаем пакеты, нужные для работы и сборки Python-пакетов:
# curl - для healthcheck и скачивания файлов
# libopenblas-dev - оптимизированные матричные вычисления (нужен для numpy/scipy)               
# git - для скачивания моделей с Hugging Face        
# gcc - компилятор C (нужен для сборки некоторых пакетов)                
# g++ - компилятор C++ (нужен для сборки некоторых пакетов)                        
# && rm -rf /var/lib/apt/lists/* - удаляем кэш apt, чтобы уменьшить размер образа           
RUN apt-get update && apt-get install -y \
    curl \     
    libopenblas-dev \ 
    git \     
    gcc \     
    g++ \         
    && rm -rf /var/lib/apt/lists/*  

# Устанавливаем рабочую директорию (все следующие команды будут выполняться из неё)
WORKDIR /app

# ============================================
# 2. PYTHON ЗАВИСИМОСТИ
# ============================================
# Копируем файл с зависимостями
COPY requirements.cuda.txt .

# Обновляем pip и устанавливаем все зависимости
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.cuda.txt && \
    pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cu126
# --no-cache-dir - не сохранять кэш pip, чтобы уменьшить размер образа

# ============================================
# 3. ПОЛЬЗОВАТЕЛЬ И ПРАВА
# ============================================
# Создаём пользователя appuser с UID 1000
# UID 1000 - стандартный ID первого пользователя в Linux
# Это нужно, чтобы файлы в контейнере принадлежали тому же пользователю,
# что и на хосте (если на хосте UID тоже 1000)
RUN useradd -m -u 1000 appuser

# Создаём папки для моделей и логов
RUN mkdir -p /app/models /app/logs

# Назначаем владельцем папок пользователя appuser
RUN chown -R appuser:appuser /app

# Даём права:
# 7 (rwx) - владелец (appuser) может читать, писать, выполнять
# 5 (r-x) - группа может читать и выполнять
# 5 (r-x) - остальные могут читать и выполнять
RUN chmod 755 /app/models /app/logs

# ============================================
# 4. ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ
# ============================================
# PYTHONUNBUFFERED=1 - логи выводятся сразу, без буферизации
# OMP_NUM_THREADS=1 - ограничиваем количество потоков для OpenBLAS (предотвращает конфликты)
# TOKENIZERS_PARALLELISM=false - отключаем параллелизм токенизаторов (предотвращает deadlock'и)
ENV PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    TOKENIZERS_PARALLELISM=false

# ============================================
# ВАЖНО: мы НЕ переключаемся на appuser здесь
# ============================================
# Это базовый образ. Переключение на пользователя делается в dockerfile.service
# после того, как скопирован код приложения