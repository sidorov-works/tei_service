# dockerfile.service

# Наследуемся от базового образа, где уже установлены все зависимости
FROM tei-base:latest

# ============================================
# 1. КОПИРОВАНИЕ КОДА ПРИЛОЖЕНИЯ
# ============================================

# Копируем весь код из текущей директории в /app внутри контейнера
COPY . .

# ============================================
# 2. ПРАВА НА ФАЙЛЫ
# ============================================

# Меняем владельца всех файлов на appuser
# Это нужно, потому что COPY копирует файлы от root
RUN chown -R appuser:appuser /app

# ============================================
# 3. ПЕРЕКЛЮЧЕНИЕ НА ПОЛЬЗОВАТЕЛЯ
# ============================================

# Теперь все процессы будут запускаться от пользователя appuser, а не от root
# Это безопасно: если злоумышленник взломает приложение, он не получит root-доступ
USER appuser

# ============================================
# 4. HEALTHCHECK
# ============================================

# Docker будет проверять здоровье контейнера каждые 30 секунд
# Если curl вернёт ошибку, контейнер будет считаться unhealthy
# start-period=30s - даём 30 секунд на запуск, прежде чем считать контейнер больным
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT:-8260}/health || exit 1